# Absolute path to the SQLite file used by Prisma.
# The db:* scripts in package.json inline this automatically (DATABASE_URL="$(pwd)/db/custom.db"),
# but if you run `prisma` directly, export this variable first.
DATABASE_URL="file:/absolute/path/to/apps/02-customer-support-copilot/db/custom.db"

# --- Optional: real semantic embeddings (defaults to a deterministic hashing embedder) ---
# EMBEDDINGS_API_KEY=
# OPENAI_API_KEY=
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-small

# --- Optional: disable the live LLM (forces the mock provider so drafts come back deterministically) ---
# CSC_DISABLE_LLM=1
